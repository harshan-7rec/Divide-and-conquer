#include<stdio.h>
int main()
{
    int m;
    scanf("%d",&m);
    int arr[m];
    for(int i=0;i<m;i++)
    {
        scanf("%d",&arr[i]);
    }
    int l=0;
    int h=m-1;
    int z=-1;
    while(l<=h)
    {
        int mid=(l+h)/2;
        if(arr[mid]==0)
        {
            z=mid;
            h=mid-1;
        }
        else
        {
            l=mid+1;
        }
    }
    if(z==-1)
    {
        printf("0");
    }
    else
    {
        printf("%d",m-z);
    }
}
