#include <stdio.h>

int main() {
    int n, x;
    scanf("%d", &n);
    int arr[n];
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);
    scanf("%d", &x);

    int low = 0, high = n - 1;
    int found = 0;

    while (low < high) {
        int sum = arr[low] + arr[high];
        if (sum == x) {
            printf("%d\n%d\n", arr[low], arr[high]);
            found = 1;
            break;
        }
        if (sum > x)
            high--;
        else
            low++;
    }

    if (!found)
        printf("No\n");

    return 0;
}
